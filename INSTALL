# 仅计算 dRMS
python3 -m ctgomartini.analysis.remd_drms_analysis \
    --mode calculate \
    -nc output.nc \
    -ref Closed/Closed_cg.pdb Open/Open_cg.pdb \
    -o dRMSTraj

# 仅绘图
python3 -m ctgomartini.analysis.remd_drms_analysis \
    --mode plot \
    -o dRMSTraj \
    --dt 0.005

# 计算并绘图
python3 -m ctgomartini.analysis.remd_drms_analysis \
    --mode both \
    -nc output.nc \
    -ref Closed/Closed_cg.pdb Open/Open_cg.pdb \
    -o dRMSTraj \
    --skip 10