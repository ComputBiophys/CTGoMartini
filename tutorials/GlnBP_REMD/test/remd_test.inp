; Test REMD without unsampled states
mini_nstep  = 0
mini_Tol    = 1000.0
gen_vel     = yes
gen_temp    = 310
gen_seed    = 
nstep       = 5000
dt          = 0.020
b_step      = 0
input       = npt.gro
topol       = system.top
ichk        = 
platform    = CUDA
precision   = single
GPU_id      = 
fric_coeff  = 0.1
nonbonded_cutoff = 1.1
epsilon_r   = 15.0
const_tol   = 1e-5
pcouple     = yes
p_ref       = 1.0
p_type      = isotropic
p_freq      = 100
rest        = no
rest_ref    = npt.gro
rest_file   = restraints.txt
gen_rest    = no
atomname    = BB
fc          = 1000.0
