remd        = yes
exc_freq    = 250
replica_count   = 2
replica_molname = GlnBP
replica_method  = exp
replica_temp    = 310.0
replica_coupling = 1/300
replica_c1      = -300 -200
replica_c2      = 0
remd_output = test_output.nc
remd_checkpoint_interval = 5
remd_online_analysis_interval = 2000
remd_mixing_scheme = swap-neighbors
